# Fenfa environment variables (override config.json)
FENFA_PORT=8000
FENFA_DATA_DIR=data
FENFA_PRIMARY_DOMAIN=http://localhost:8000
# Optional first-run bootstrap credentials. If omitted, create the account in the setup form.
FENFA_ADMIN_USERNAME=admin
FENFA_ADMIN_PASSWORD=change-this-password
# Optional legacy admin API token; web login uses the account above.
FENFA_ADMIN_TOKEN=
FENFA_UPLOAD_TOKEN=dev-upload-token
# Comma-separated proxy IPs/CIDRs allowed to supply client IP headers; leave empty when directly exposed
FENFA_TRUSTED_PROXIES=
