FENFA_IMAGE=ghcr.io/rinnmoe/fenfa:v0.5.0
FENFA_ADMIN_USERNAME=admin
FENFA_ADMIN_PASSWORD=change-this-password
# Required when bootstrap credentials are omitted.
FENFA_SETUP_TOKEN=
# Optional compatibility token for legacy API clients; not used for web login.
FENFA_ADMIN_TOKEN=
FENFA_UPLOAD_TOKEN=
FENFA_PRIMARY_DOMAIN=https://release.example.com
# Reverse proxy IP/CIDR, e.g. 172.18.0.1/16; leave empty if Fenfa is directly exposed
FENFA_TRUSTED_PROXIES=
